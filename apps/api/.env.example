# Copy to .env for local dev. Never commit real keys; prod/staging keys live in Google Secret Manager.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Local services from docker-compose.yml
DATABASE_URL=postgres://sayvox:sayvox@localhost:5432/sayvox
REDIS_URL=redis://localhost:6379

# Google Cloud (ADR-006)
GCP_PROJECT_ID=sayvox-app-2026
# Use the Firebase Auth emulator locally instead of real Identity Platform
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Providers (dev keys with low spend limits)
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=

# Billing (Razorpay test mode only outside prod, ADR-003)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Sayvox plan id -> Razorpay plan id (create the plan in the Razorpay dashboard, test mode)
RAZORPAY_PLAN_IDS={}
