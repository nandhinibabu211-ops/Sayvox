# Static pages on Cloud Run (port 8080). Same behaviour as the old firebase.json:
# clean URLs (/signin serves signin.html), security headers, and no caching for /signin.
# This is a template: the nginx image fills ${FIREBASE_API_KEY}, ${FIREBASE_AUTH_DOMAIN},
# ${GOOGLE_SIGNIN} and ${API_BASE_URL} from the container environment at start (only variables that are set),
# so one image serves every environment.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;

    # Hashed build assets never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }

    # The sign-in page carries a one-time state in its URL: never cache it.
    location = /signin {
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Frame-Options "DENY" always;
        try_files /signin.html =404;
    }

    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 200 'window.SAYVOX_CONFIG = { apiKey: "${FIREBASE_API_KEY}", authDomain: "${FIREBASE_AUTH_DOMAIN}", googleSignIn: "${GOOGLE_SIGNIN}", apiBaseUrl: "${API_BASE_URL}" };';
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }
}
