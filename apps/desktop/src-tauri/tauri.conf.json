{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sayvox",
  "version": "0.1.0",
  "identifier": "app.sayvox.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sayvox",
        "width": 480,
        "height": 320,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:8787 https://*.a.run.app https://securetoken.googleapis.com; style-src 'self'; img-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["sayvox"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
