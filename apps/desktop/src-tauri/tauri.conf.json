{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sayvox",
  "version": "0.1.0",
  "identifier": "app.sayvox.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sayvox",
        "url": "index.html",
        "width": 720,
        "height": 480,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Sayvox overlay",
        "url": "overlay.html",
        "width": 420,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:8787 https://*.a.run.app https://securetoken.googleapis.com wss://api.elevenlabs.io; style-src 'self'; img-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["sayvox"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
